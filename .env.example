# duckdb = local development without a cluster; exasol = real target
CAUSA_BACKEND=duckdb
CAUSA_DUCKDB_PATH=data/causa.duckdb

# CAUSA_BACKEND=exasol
CAUSA_EXASOL_DSN=localhost:8563
CAUSA_EXASOL_USER=sys
CAUSA_EXASOL_PASSWORD=exasol
CAUSA_EXASOL_ENCRYPTION=true
# Only for the docker-db self-signed certificate
CAUSA_EXASOL_TLS_INSECURE=true

# Investigator agent (Ask tab, causa ask): one key is enough.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# CAUSA_AGENT_PROVIDER=auto        # auto | anthropic | openai
# CAUSA_OPENAI_MODEL=gpt-5-nano

# Answer from a local copy while Exasol is unreachable (e.g. an idle SaaS cluster that stopped)
# CAUSA_FALLBACK_DUCKDB_PATH=data/causa.duckdb

# Watching (causa serve / causa watch)
# CAUSA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# CAUSA_WATCH_MINUTES=15
# CAUSA_BRIEF_AT=07:00
# CAUSA_BRIEF_METRIC=net_revenue
